VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=litterspot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=litterspot
# Required by the Firebase web-app configuration, but LitterSpot media remains local.
VITE_FIREBASE_STORAGE_BUCKET=litterspot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_DATABASE_ID=(default)
