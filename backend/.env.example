# The backend API port. `npm start` and the Vite /api proxy read this value.
APP_ENV=production-cloud
EXPECTED_FIREBASE_PROJECT_ID=litterspot
PORT=3000
ANALYTICS_WORKER_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=change-me
FIREBASE_PROJECT_ID=litterspot
FIREBASE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-service-account.json
# Optional. Leave unset to use <repository>/data/media-store on every OS.
# MEDIA_STORAGE_ROOT=/custom/absolute/path/to/media-store
# VIDEO_UPLOAD_TEMP_ROOT=/custom/absolute/path/to/media-store/.incoming
VIDEO_MAX_BYTES=262144000
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_FRAME_INTERVAL_SECONDS=1
VIDEO_MAX_FRAMES=300
VIDEO_LEASE_SECONDS=300
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
GENERAL_RATE_LIMIT_PER_MINUTE=300
INFERENCE_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=20
PROCESSING_MUTATION_RATE_LIMIT_PER_MINUTE=60
ORCHESTRATOR_INTERNAL_TOKEN=change-me
ORCHESTRATOR_LEASE_SECONDS=300
ORCHESTRATOR_WORKER_ENABLED=true

# Optional prerecorded scenes for the final prototype. Cloud access is Root-only.
CAMERA_DEMO_SCENES_ENABLED=true
