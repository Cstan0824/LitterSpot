  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "form-data": "^4.0.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.24.3"
