{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "bootstrap:supervisor": "tsx src/scripts/bootstrapSupervisor.ts",
    "smoke:system-events": "tsx src/scripts/smokeSystemEvents.ts",
    "smoke:bin-replacement": "tsx src/scripts/smokeBinReplacement.ts",
    "media:retention": "tsx src/scripts/mediaRetention.ts",
    "database:inspect-target": "tsx src/scripts/inspectTarget.ts",
    "database:validate-schema": "tsx src/scripts/validateSchema.ts",
    "database:reset-application-data": "tsx src/scripts/resetApplicationData.ts",
    "database:clear-emulator-operations": "tsx src/scripts/clearEmulatorOperationalData.ts",
    "database:bootstrap-development": "tsx src/scripts/bootstrapDevelopmentSite.ts",
    "demo:seed-shared": "tsx src/scripts/seedSharedDemoOperations.ts",
    "demo:seed-bin-comparison": "tsx src/scripts/seedBinPlacementComparison.ts",
    "demo:verify-bin-comparison": "tsx src/scripts/seedBinPlacementComparison.ts",
    "smoke:orchestrator-provider": "tsx src/scripts/smokeOrchestratorProvider.ts",
    "test": "vitest run --maxWorkers=1 --minWorkers=1"
