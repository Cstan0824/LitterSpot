PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=change-me
FIREBASE_PROJECT_ID=litterspot-v2-database
FIREBASE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-service-account.json
MEDIA_STORAGE_ROOT=/absolute/path/to/LitterSpot/data/media-store
VIDEO_UPLOAD_TEMP_ROOT=/absolute/path/to/LitterSpot/data/media-store/.incoming
VIDEO_MAX_BYTES=262144000
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=300
VIDEO_LEASE_SECONDS=300
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GENERAL_RATE_LIMIT_PER_MINUTE=300
INFERENCE_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=20
PROCESSING_MUTATION_RATE_LIMIT_PER_MINUTE=60
ORCHESTRATOR_INTERNAL_TOKEN=change-me
ORCHESTRATOR_LEASE_SECONDS=300
ORCHESTRATOR_PYTHON_PATH=/absolute/path/to/LitterSpot/.venv/bin/python
ORCHESTRATOR_DEBUG_OUTPUT=false
ORCHESTRATOR_DEBUG_ROOT=/absolute/path/to/LitterSpot/data/orchestrator-debug
ORCHESTRATOR_WORKER_ENABLED=true
ANALYTICS_WORKER_ENABLED=false
SITE_OPERATION_RECOVERY_INTERVAL_MS=300000
SITE_OPERATION_RECOVERY_MAX_BACKOFF_MS=3600000
MODEL_PATH=../models/production/bin_overflow_themepark_v3.pt
MODEL_VERSION=bin-overflow-themepark-v3
INTERNAL_API_TOKEN=change-me
