{
  "name": "litterspot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "demo:camera-scene": "node scripts/demo-camera-scene.mjs",
    "demo:scene:clean": "node scripts/switch-emulator-camera-scene.mjs clean",
    "demo:scene:dirty": "node scripts/switch-emulator-camera-scene.mjs dirty",
    "test:camera:fixture": "tsx scripts/camera-runtime-fixture.mts",
    "test:camera:browser": "node scripts/test-camera-runtime-browser.mjs",
    "test:camera:buffer-timeout": "node scripts/test-camera-buffer-timeout-browser.mjs",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "test:backend": "npm --workspace=backend run test",
    "test:assignment": "node scripts/test-task-assignment.mjs",
    "test:assignment:model": "node scripts/test-task-assignment-model.mjs",
    "demo:assignment": "node scripts/demo-task-assignment.mjs",
    "test:emulator": "node scripts/run-firestore-emulator-tests.mjs",
    "start": "node scripts/start-local.mjs",
    "start:api": "node scripts/start-api.mjs",
    "stop": "node scripts/stop-local.mjs",
    "start:local": "node scripts/start-api.mjs",
    "start:emulator": "node scripts/start-emulator-dev.mjs",
    "start:cloud": "node scripts/start-local.mjs",
    "fixture:emulator:update": "node scripts/prepare-team-emulator-fixture.mjs",
    "fixture:emulator:reset": "node scripts/reset-team-emulator-fixture.mjs",
    "fixture:emulator:verify": "node scripts/verify-team-emulator-fixture.mjs",
    "fixture:bin-placement": "npm --workspace=backend run demo:seed-bin-comparison",
    "fixture:bin-placement:verify": "npm --workspace=backend run demo:verify-bin-comparison",
    "media:compress:emulator": "node scripts/compress-emulator-videos.mjs",
    "media:compress:emulator:apply": "node scripts/compress-emulator-videos.mjs --apply",
    "media:sync:emulator": "node scripts/sync-emulator-media-metadata.mjs",
    "stop:local": "node scripts/stop-local.mjs"
  },
  "devDependencies": {
    "firebase-tools": "^15.26.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
